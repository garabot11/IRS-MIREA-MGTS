Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: []
      Splitter Ratio: 0.64
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
Visualization Manager:
  Class: ''
  Name: root
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 17; 23; 32
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Карта прохода 1
      Enabled: true
      Topic:
        Value: /kontur/map3d
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 159; 178; 201
      Style: Points
      Size (Pixels): 2
      Alpha: 0.52
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Текущий скан
      Enabled: true
      Topic: {Value: /kontur/scan, Reliability Policy: Best Effort}
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 151; 90
      Style: Points
      Size (Pixels): 3
      Alpha: 0.95
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Пройденный путь
      Enabled: true
      Topic: {Value: /kontur/path, Reliability Policy: Best Effort}
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.14
      Color: 69; 231; 233
      Alpha: 1
      Offset: {X: 0, Y: 0, Z: 0.04}
      Pose Style: None
    - Class: rviz_default_plugins/Pose
      Name: Поза робота
      Enabled: true
      Topic: {Value: /kontur/pose, Reliability Policy: Best Effort}
      Shape: Arrow
      Color: 255; 231; 86
      Shaft Length: 0.66
      Shaft Radius: 0.14
      Head Length: 0.44
      Head Radius: 0.29
      Alpha: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Коридор сверху
      Target Frame: map
      Angle: 1.5707963
      X: 0.41
      Y: 8.78
      Scale: 21
    Saved: []
Window Geometry:
  X: 0
  Y: 0
  Width: 1240
  Height: 700
  Hide Left Dock: false
  Hide Right Dock: false
  Displays:
    collapsed: false
  Time:
    collapsed: false
  QMainWindow State: 
